# Copy to /opt/startpage/.env on the server and fill in. Never commit the real file.

# Login password for the personal instance (8 to 72 bytes).
STARTPAGE_PASSWORD=

# Must match the values in /opt/infra/.env.
STARTPAGE_DB_PASSWORD=
STARTPAGE_DEMO_DB_PASSWORD=

# Image tag; the CI deploy pins it to the commit SHA, manual runs use latest.
# STARTPAGE_TAG=latest
