# Copy to /opt/infra/.env on the server and fill in. Never commit the real file.
# Generate passwords with: openssl rand -hex 24  (they go into URLs: hex is safe)

# Let's Encrypt account e-mail (expiry notices).
ACME_EMAIL=

# Hostnames; their DNS A records must point at this server before Caddy starts.
HOME_DOMAIN=home.example.com
DEMO_DOMAIN=demo.example.com
# The bare domain; it and www.<it> redirect to DEMO_DOMAIN.
APEX_DOMAIN=example.com

# Postgres superuser; only for admin work and backups, no app uses it.
POSTGRES_PASSWORD=

# Per-app database passwords; the same values go into /opt/startpage/.env.
STARTPAGE_DB_PASSWORD=
STARTPAGE_DEMO_DB_PASSWORD=
