# Copy to .env and fill in. .env is git-ignored.

# Login password for the start page (at least 8 characters).
STARTPAGE_PASSWORD=change-me-please

# Password for the bundled Postgres. Goes into a URL, so stick to letters, digits, - and _.
POSTGRES_PASSWORD=change-me-too

# Host port the app is published on (bound to 127.0.0.1 only).
STARTPAGE_PORT=8080

# Set to true when serving over HTTPS (adds the Secure flag to the session cookie).
STARTPAGE_SECURE_COOKIE=false

# Set to true only behind a reverse proxy you control: the last X-Forwarded-For
# entry is then used as the client IP for login rate limiting.
STARTPAGE_TRUST_PROXY=false

# How often services are probed (Go duration, minimum 5s).
STARTPAGE_MONITOR_INTERVAL=1m

LOG_LEVEL=info
